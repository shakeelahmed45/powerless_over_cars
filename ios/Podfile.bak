# CocoaPods analytics disabled
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# Use CDN (faster & avoids "hanging on pod install")
source 'https://cdn.cocoapods.org/'

platform :ios, '13.0'

# Static frameworks + modular headers (Flutter default)
use_frameworks! :linkage => :static
use_modular_headers!

project 'Runner', 'Debug' => :debug, 'Profile' => :release, 'Release' => :release

# Locate a podhelper.rb (prefer ios/Flutter, fall back to .ios/Flutter)
helper_candidates = [
  File.expand_path(File.join(__dir__, 'Flutter', 'podhelper.rb')),
  File.expand_path(File.join(File.expand_path('..', __dir__), '.ios', 'Flutter', 'podhelper.rb')),
]
podhelper_path = helper_candidates.find { |p| File.exist?(p) }

if podhelper_path
  puts "✅ Using podhelper.rb from #{podhelper_path}"
  require podhelper_path
else
  abort("❌ podhelper.rb not found in ios/Flutter or .ios/Flutter.\n" \
        "Run these first:\n" \
        "  flutter precache --ios\n" \
        "  flutter pub get\n" \
        "Then try again.")
end

target 'Runner' do
  flutter_ios_podfile_setup if defined?(flutter_ios_podfile_setup)
  flutter_install_all_ios_pods(File.dirname(File.realpath(__FILE__))) if defined?(flutter_install_all_ios_pods)
end

post_install do |installer|
  # Apply Flutter’s recommended build settings across pods
  flutter_additional_ios_build_settings(installer) if defined?(flutter_additional_ios_build_settings)

  # Intel Mac fix: exclude arm64 for iOS Simulator builds
  installer.pods_project.targets.each do |t|
    t.build_configurations.each do |c|
      c.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] ||= 'arm64'
      c.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] ||= 'YES'
      c.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] ||= '13.0'
    end
  end

  puts "✅ Post-install completed."
end

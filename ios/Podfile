# CocoaPods analytics disabled
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

platform :ios, '13.0'

use_frameworks! :linkage => :static
use_modular_headers!

project 'Runner', 'Debug' => :debug, 'Profile' => :release, 'Release' => :release

# --- Safe Flutter root discovery and Generated.xcconfig fallback ---
def flutter_root
  generated_xcconfig = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __dir__)

  unless File.exist?(generated_xcconfig)
    puts "⚠️  Warning: Generated.xcconfig not found. Creating placeholder so build continues..."
    FileUtils.mkdir_p(File.dirname(generated_xcconfig))
    File.write(generated_xcconfig, "# Temporary Generated.xcconfig placeholder\nFLUTTER_ROOT=/tmp/flutter\n")
  end

  File.foreach(generated_xcconfig) do |line|
    return $1.strip if line =~ /FLUTTER_ROOT=(.*)/
  end

  puts "⚠️  FLUTTER_ROOT not found in Generated.xcconfig. Using environment variable instead."
  return ENV['FLUTTER_ROOT'] || '/usr/local/flutter'
end

# ✅ Fixed typo here: flutter_tools
require File.expand_path('packages/flutter_tools/bin/podhelper', flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  flutter_install_all_ios_pods(File.dirname(File.realpath(__FILE__)))
end

# --- Safe post_install block ---
post_install do |installer|
  begin
    installer.pods_project.targets.each do |target|
      flutter_additional_ios_build_settings(target)
    end
  rescue NoMethodError => e
    puts "⚠️  Skipping flutter_additional_ios_build_settings: #{e.message}"
  end
end

# CocoaPods analytics disabled
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

platform :ios, '13.0'

use_frameworks! :linkage => :static
use_modular_headers!

project 'Runner', 'Debug' => :debug, 'Profile' => :release, 'Release' => :release

# --- Safe Flutter root detection ---
def flutter_root
  # Prefer environment FLUTTER_ROOT (set by GitHub Actions or Codemagic)
  env_root = ENV['FLUTTER_ROOT']
  return env_root unless env_root.nil? || env_root.empty?

  # Fallback to Generated.xcconfig if present
  generated_xcconfig = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __dir__)
  if File.exist?(generated_xcconfig)
    File.foreach(generated_xcconfig) do |line|
      return $1.strip if line =~ /FLUTTER_ROOT=(.*)/
    end
  end

  puts "⚠️  FLUTTER_ROOT not found. Defaulting to /Users/runner/hostedtoolcache/flutter/stable-3.24.3-arm64"
  return '/Users/runner/hostedtoolcache/flutter/stable-3.24.3-arm64'
end

# ✅ Correct path for Flutter CocoaPods helper
require File.expand_path('packages/flutter_tools/bin/podhelper', flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  flutter_install_all_ios_pods(File.dirname(File.realpath(__FILE__)))
end

# --- Safe post_install block ---
post_install do |installer|
  begin
    installer.pods_project.targets.each do |target|
      flutter_additional_ios_build_settings(target)
    end
  rescue NoMethodError => e
    puts "⚠️  Skipping flutter_additional_ios_build_settings: #{e.message}"
  end
end
